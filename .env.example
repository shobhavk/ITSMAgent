# Copy this file to .env and fill in real values. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

# Comma-separated API keys accepted for the REST API (X-API-Key header)
API_KEYS=replace-with-a-long-random-key
ALLOWED_ORIGINS=http://localhost:7860,http://localhost:8000
MAX_UPLOAD_MB=15
RATE_LIMIT=30/minute

# LLM_PROVIDER: rule_based | openai_compat | sap_genai_hub
LLM_PROVIDER=rule_based
CHAT_MODEL_NAME=gpt-5.6-luna
EMBEDDING_MODEL_NAME=text-embedding-large

# --- Only needed if LLM_PROVIDER=sap_genai_hub ---
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# --- Only needed if LLM_PROVIDER=openai_compat ---
LLM_BASE_URL=
LLM_API_KEY=

SIMILARITY_THRESHOLD=0.35

# Rate limiting / scale (see app/services/llm_client.py docstring - this is
# what actually fixes 429s on large uploads, not the API surface used)
LLM_RATE_LIMIT_MAX_RETRIES=5
EMBEDDING_BATCH_SIZE=200
LLM_MAX_CONCURRENCY=10

# --- Observability (Step 15) ---
# Console logging is always on. Set LOG_FILE_ENABLED=true to also write rotating files
# to LOG_DIR (itsm_events.jsonl = structured events, itsm_app.log = application log
# with stack traces). Keep LOG_DIR OUTSIDE the knowledge-base / database directory and
# restrict who can read it: stack traces live there.
LOG_LEVEL=INFO
OBS_ENABLED=true
LOG_FILE_ENABLED=false
LOG_DIR=logs
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=5
# true = also log a redacted 120-char preview of each question (off by default)
OBS_DETAILED_DIAGNOSTICS=false
# Needed to view the "recent events" table on the Observability tab. Empty = table disabled.
OBS_ADMIN_TOKEN=
